    .section {
        padding: 40px 20px;
        max-width: 1200px;
        margin: auto;
    }

    .intro {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 30px;
    }

    .intro-text {
        flex: 1;
        min-width: 280px;
    }

        .intro-text h2 {
            margin-top: 0;
        }

        .intro-text button {
            background: orange;
            color: white;
            border: none;
            padding: 10px 20px;
            margin-right: 10px;
            cursor: pointer;
            border-radius: 5px;
        }

    .intro img {
        flex: 1;
        min-width: 280px;
        max-width: 400px;
        border-radius: 10px;
    }

    .promo-section {
        background: #5c432d;
        color: white;
        padding: 40px 20px;
    }

        .promo-section h2 {
            text-align: center;
            margin-bottom: 40px;
        }

    .promos {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: center;
    }

    .promo-card {
        background: white;
        color: #333;
        border-radius: 10px;
        overflow: hidden;
        max-width: 300px;
        flex: 1;
        min-width: 250px;
    }

        .promo-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

    .promo-card-content {
        padding: 20px;
    }

        .promo-card-content h3 {
            margin-top: 0;
        }

        .promo-card-content ul {
            padding-left: 20px;
        }

        .promo-card-content button {
            background: orange;
            color: white;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 5px;
            margin-top: 10px;
        }

    .services {
        text-align: center;
        padding: 40px 20px;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .service-card img {
        width: 100%;
        border-radius: 5px;
    }

    .service-card h4 {
        margin: 10px 0 5px 0;
    }
</style>


<section class="section intro">
    <div class="intro-text">
        <h2>Travel made easy</h2>
        <p>
            Write a paragraph that talks about your company here. You can talk about your company’s background, history, mission, vision, or philosophy. Anything that will introduce your brand’s persona to your clients.
        </p>
        <button>Latest Promos</button>
        <button>Our Offerings</button>
    </div>
    <img src="travel.jpg" alt="Travel Image">
</section>

<section class="promo-section">
    <h2>Summer Deals Promo</h2>
    <div class="promos">
        @if (promos != null && promos.Any())
        {
            foreach (var promo in promos)
            {
                <div class="promo-card">
                    <img src="@promo.ImageUrl" alt="@promo.Caption">
                    <div class="promo-card-content">
                        <h3>@promo.Caption</h3>
                        <p>Starts at @promo.Amount</p>
                        <ul>
                            @if (promo.Features != null)
                            {
                                foreach (var feature in promo.Features)
                                {
                                    <li>@feature</li>
                                }
                            }
                        </ul>
                        <button>Book Now</button>
                    </div>
                </div>
            }
        }
        else
        {
            <p>No promos available.</p>
        }
    </div>
</section>



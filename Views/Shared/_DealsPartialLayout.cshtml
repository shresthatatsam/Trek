<section class="services">
    <h2>We'll handle your trip for you</h2>
    <div class="services-grid">
        <div class="service-card">
            <img src="flight.jpg" alt="Flight Booking">
            <h4>Flight Booking</h4>
            <p>Share your service offerings here.</p>
        </div>
        <div class="service-card">
            <img src="tours.jpg" alt="Tours & Activities">
            <h4>Tours & Activities</h4>
            <p>Share your service offerings here.</p>
        </div>
        <div class="service-card">
            <img src="transfer.jpg" alt="Airport Transfers">
            <h4>Airport Transfers</h4>
            <p>Share your service offerings here.</p>
        </div>
        <div class="service-card">
            <img src="hotel.jpg" alt="Hotel Bookings">
            <h4>Hotel Bookings</h4>
            <p>Share your service offerings here.</p>
        </div>
    </div>
</section>

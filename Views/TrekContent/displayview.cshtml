@model UserRoles.ViewModels.TrekPackageDisplayViewModel
@{
    ViewData["Title"] = Model.TrekPackage.Title;
    var rating = Model.AverageRating;
    var reviewCount = Model.TotalReviews;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.TrekPackage.Title - Adventure Trekking</title>
    <meta name="description" content="@Model.TrekPackage.ShortDescription">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #f8f9fa;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header */
        .header {
            background: linear-gradient(135deg, #2c5aa0 0%, #1e3a5f 100%);
            color: white;
            padding: 2rem 0;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><path d="M0,0 L100,0 L100,80 L0,100 Z" fill="rgba(255,255,255,0.1)"/></svg>');
            background-size: cover;
        }

        .header-content {
            position: relative;
            z-index: 1;
        }

        .trek-title {
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .trek-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-bottom: 2rem;
        }

        .trek-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            align-items: center;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255,255,255,0.2);
            padding: 0.5rem 1rem;
            border-radius: 25px;
            backdrop-filter: blur(10px);
        }

        .meta-item i {
            font-size: 1.1rem;
        }

        /* Featured Image */
        .featured-image {
            width: 100%;
            height: 400px;
            object-fit: cover;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            margin: 2rem 0;
        }

        /* Main Content */
        .main-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 3rem;
            margin: 2rem 0;
        }

        .content-section {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.8rem;
            color: #2c5aa0;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .section-title::before {
            content: '';
            width: 4px;
            height: 2rem;
            background: linear-gradient(135deg, #2c5aa0, #1e3a5f);
            border-radius: 2px;
        }

        /* Overview */
        .overview-description {
            font-size: 1.1rem;
            line-height: 1.8;
            margin-bottom: 1.5rem;
            color: #555;
        }

        .key-points {
            list-style: none;
            padding: 0;
        }

        .key-points li {
            padding: 0.5rem 0;
            padding-left: 2rem;
            position: relative;
            border-bottom: 1px solid #eee;
        }

        .key-points li:before {
            content: '✓';
            position: absolute;
            left: 0;
            color: #28a745;
            font-weight: bold;
            font-size: 1.2rem;
        }

        /* Itinerary */
        .itinerary-day {
            border: 1px solid #e9ecef;
            border-radius: 10px;
            margin-bottom: 1rem;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .itinerary-day:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

        .day-header {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            padding: 1rem 1.5rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .day-number {
            background: #2c5aa0;
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .day-title {
            flex: 1;
            margin-left: 1rem;
            font-weight: 600;
            color: #333;
        }

        .day-content {
            padding: 1.5rem;
            display: none;
            background: white;
        }

        .day-content.active {
            display: block;
        }

        .day-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .detail-item i {
            color: #2c5aa0;
        }

        /* Highlights */
        .highlights-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .highlight-card {
            text-align: center;
            padding: 1.5rem;
            border: 1px solid #e9ecef;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .highlight-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border-color: #2c5aa0;
        }

        .highlight-icon {
            font-size: 2.5rem;
            color: #2c5aa0;
            margin-bottom: 1rem;
        }

        .highlight-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #333;
        }

        /* Sidebar */
        .sidebar {
            position: sticky;
            top: 2rem;
            height: fit-content;
        }

        .booking-card {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            text-align: center;
            margin-bottom: 2rem;
        }

        .price-display {
            font-size: 2.5rem;
            font-weight: bold;
            color: #2c5aa0;
            margin-bottom: 0.5rem;
        }

        .price-note {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }

        .book-now-btn {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            border: none;
            padding: 1rem 2rem;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 50px;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .book-now-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(40, 167, 69, 0.3);
        }

        .quick-info {
            background: white;
            padding: 1.5rem;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .info-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid #eee;
        }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-label {
            font-weight: 600;
            color: #555;
        }

        .info-value {
            color: #2c5aa0;
            font-weight: 500;
        }

        /* Gallery */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1rem;
        }

        .gallery-item {
            position: relative;
            overflow: hidden;
            border-radius: 10px;
            aspect-ratio: 4/3;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        .gallery-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0,0,0,0.8));
            color: white;
            padding: 1rem;
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }

        .gallery-item:hover .gallery-overlay {
            transform: translateY(0);
        }

        /* Reviews */
        .review-card {
            border: 1px solid #e9ecef;
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 1rem;
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .reviewer-name {
            font-weight: 600;
            color: #333;
        }

        .review-rating {
            color: #ffc107;
        }

        .review-date {
            color: #666;
            font-size: 0.9rem;
        }

        .review-text {
            color: #555;
            line-height: 1.6;
        }

        /* FAQ */
        .faq-item {
            border: 1px solid #e9ecef;
            border-radius: 10px;
            margin-bottom: 1rem;
            overflow: hidden;
        }

        .faq-question {
            padding: 1rem 1.5rem;
            background: #f8f9fa;
            cursor: pointer;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .faq-answer {
            padding: 1.5rem;
            display: none;
            color: #555;
            line-height: 1.6;
        }

        .faq-answer.active {
            display: block;
        }

        /* Responsive Design */
        media (max-width: 768px) {
            .main-content {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .trek-title {
                font-size: 2rem;
            }

            .trek-meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .highlights-grid {
                grid-template-columns: 1fr;
            }

            .gallery-grid {
                grid-template-columns: 1fr;
            }

            .day-details {
                grid-template-columns: 1fr;
            }
        }

        /* Animations */
        keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .content-section {
            animation: fadeInUp 0.6s ease forwards;
        }

        .content-section:nth-child(even) {
            animation-delay: 0.1s;
        }

        .content-section:nth-child(odd) {
            animation-delay: 0.2s;
        }

        .rating-stars {
            color: #ffc107;
            margin-left: 0.5rem;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="header-content">
                <h1 class="trek-title">@Model.TrekPackage.Title</h1>
                <p class="trek-subtitle">@Model.TrekPackage.ShortDescription</p>
                <div class="trek-meta">
                    <div class="meta-item">
                        <i class="fas fa-clock"></i>
                        <span>@Model.TrekPackage.Duration</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-mountain"></i>
                        <span>@Model.TrekPackage.Difficulty</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.MaxAltitude))
                    {
                        <div class="meta-item">
                            <i class="fas fa-arrow-up"></i>
                            <span>@Model.TrekPackage.MaxAltitude</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.TrekkingDistance))
                    {
                        <div class="meta-item">
                            <i class="fas fa-route"></i>
                            <span>@Model.TrekPackage.TrekkingDistance</span>
                        </div>
                    }
                    <div class="meta-item">
                        <i class="fas fa-star"></i>
                        <span>@rating.ToString("F1") (@reviewCount reviews)</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="container">
        <!-- Featured Image -->
        @if (!string.IsNullOrEmpty(Model.TrekPackage.FeaturedImageUrl))
        {
            <img src="@Model.TrekPackage.FeaturedImageUrl" alt="@Model.TrekPackage.Title" class="featured-image">
        }

        <div class="main-content">
            <!-- Main Content -->
            <div class="content-area">
                <!-- Overview -->
                <section class="content-section">
                    <h2 class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Trek Overview
                    </h2>
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.Overview?.Description.ToString()))
                    {
                        <div class="overview-description">
                            @Html.Raw(Model.TrekPackage.Overview.Description)
                        </div>
                    }
                    @if (Model.TrekPackage.Overview?.KeyPoints?.Any() == true)
                    {
                        <ul class="key-points">
                            @foreach (var point in Model.TrekPackage.Overview.KeyPoints)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    }
                </section>

                <!-- Highlights -->
                @if (Model.TrekPackage.Highlights?.Any() == true)
                {
                    <section class="content-section">
                        <h2 class="section-title">
                            <i class="fas fa-star"></i>
                            Trek Highlights
                        </h2>
                        <div class="highlights-grid">
                            @foreach (var highlight in Model.TrekPackage.Highlights.OrderBy(h => h.SortOrder))
                            {
                                <div class="highlight-card">
                                    <div class="highlight-icon">
                                        <i class="@(!string.IsNullOrEmpty(highlight.IconClass) ? highlight.IconClass : "fas fa-mountain")"></i>
                                    </div>
                                    <div class="highlight-title">@highlight.Title</div>
                                    @if (!string.IsNullOrEmpty(highlight.Description))
                                    {
                                        <p>@highlight.Description</p>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- Itinerary -->
                @if (Model.TrekPackage.Itinerary?.Days?.Any() == true)
                {
                    <section class="content-section">
                        <h2 class="section-title">
                            <i class="fas fa-route"></i>
                            Trek Itinerary
                        </h2>
                        
                        @foreach (var day in Model.TrekPackage.Itinerary.Days.OrderBy(d => d.DayNumber))
                        {
                            <div class="itinerary-day">
                                <div class="day-header" onclick="toggleDay(this)">
                                    <div class="day-number">@day.DayNumber</div>
                                    <div class="day-title">@day.Title</div>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                                <div class="day-content">
                                    @if (!string.IsNullOrEmpty(day.Description))
                                    {
                                        <p>@day.Description</p>
                                    }
                                    <div class="day-details">
                                        @if (!string.IsNullOrEmpty(day.Altitude))
                                        {
                                            <div class="detail-item">
                                                <i class="fas fa-map-marker-alt"></i>
                                                <span>Altitude: @day.Altitude</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(day.Duration))
                                        {
                                            <div class="detail-item">
                                                <i class="fas fa-clock"></i>
                                                <span>@day.Duration</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(day.Accommodation))
                                        {
                                            <div class="detail-item">
                                                <i class="fas fa-bed"></i>
                                                <span>@day.Accommodation</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(day.Meals))
                                        {
                                            <div class="detail-item">
                                                <i class="fas fa-utensils"></i>
                                                <span>@day.Meals</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(day.Transportation))
                                        {
                                            <div class="detail-item">
                                                <i class="fas fa-car"></i>
                                                <span>@day.Transportation</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(day.Activities))
                                        {
                                            <div class="detail-item">
                                                <i class="fas fa-hiking"></i>
                                                <span>@day.Activities</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </section>
                }

                <!-- Gallery -->
                @if (Model.TrekPackage.GalleryImages?.Any() == true)
                {
                    <section class="content-section">
                        <h2 class="section-title">
                            <i class="fas fa-images"></i>
                            Photo Gallery
                        </h2>
                        <div class="gallery-grid">
                            @foreach (var image in Model.TrekPackage.GalleryImages.OrderBy(g => g.SortOrder))
                            {
                                <div class="gallery-item">
                                    <img src="@image.ImageUrl" alt="@image.AltText">
                                    @if (!string.IsNullOrEmpty(image.Caption))
                                    {
                                        <div class="gallery-overlay">
                                            <p>@image.Caption</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- Reviews -->
                @if (Model.LatestReviews?.Any() == true)
                {
                    <section class="content-section">
                        <h2 class="section-title">
                            <i class="fas fa-star"></i>
                            Traveler Reviews
                        </h2>
                        
                        @foreach (var review in Model.LatestReviews)
                        {
                            <div class="review-card">
                                <div class="review-header">
                                    <div class="reviewer-info">
                                        <div class="reviewer-name">@review.ReviewerName</div>
                                        <div class="review-rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                @if (i <= review.Rating)
                                                {
                                                    <span>★</span>
                                                }
                                                else
                                                {
                                                    <span style="color: #ddd;">★</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="review-date">@review.ReviewDate.ToString("MMM dd, yyyy")</div>
                                </div>
                                <div class="review-text">
                                    @review.ReviewText
                                </div>
                            </div>
                        }
                    </section>
                }

                <!-- FAQ -->
                @if (Model.FAQsByCategory?.Any() == true)
                {
                    <section class="content-section">
                        <h2 class="section-title">
                            <i class="fas fa-question-circle"></i>
                            Frequently Asked Questions
                        </h2>
                        
                        @foreach (var category in Model.FAQsByCategory)
                        {
                            @if (!string.IsNullOrEmpty(category.Key))
                            {
                                <h4 style="color: #2c5aa0; margin: 1.5rem 0 1rem 0;">@category.Key</h4>
                            }
                            @foreach (var faq in category.Value.OrderBy(f => f.SortOrder))
                            {
                                <div class="faq-item">
                                    <div class="faq-question" onclick="toggleFAQ(this)">
                                        <span>@faq.Question</span>
                                        <i class="fas fa-chevron-down"></i>
                                    </div>
                                    <div class="faq-answer">
                                        @Html.Raw(faq.Answer)
                                    </div>
                                </div>
                            }
                        }
                    </section>
                }
            </div>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Booking Card -->
                <div class="booking-card">
                    <div class="price-display">@Model.TrekPackage.CostInfo.Currency @Model.TrekPackage.CostInfo.BasePrice.ToString("N0")</div>
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.CostInfo.PriceNote))
                    {
                        <div class="price-note">@Model.TrekPackage.CostInfo.PriceNote</div>
                    }
                    else
                    {
                        <div class="price-note">Per person</div>
                    }
                    <button class="book-now-btn" onclick="location.href='@Url.Action("Book", new { id = Model.TrekPackage.Id })'">Book Now</button>
                </div>

                <!-- Quick Info -->
                <div class="quick-info">
                    <h3 style="margin-bottom: 1rem; color: #2c5aa0;">Quick Info</h3>
                    <div class="info-item">
                        <span class="info-label">Duration</span>
                        <span class="info-value">@Model.TrekPackage.Duration</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Difficulty</span>
                        <span class="info-value">@Model.TrekPackage.Difficulty</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.MaxAltitude))
                    {
                        <div class="info-item">
                            <span class="info-label">Max Altitude</span>
                            <span class="info-value">@Model.TrekPackage.MaxAltitude</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.TrekkingDistance))
                    {
                        <div class="info-item">
                            <span class="info-label">Distance</span>
                            <span class="info-value">@Model.TrekPackage.TrekkingDistance</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.StartEndPoint))
                    {
                        <div class="info-item">
                            <span class="info-label">Start/End</span>
                            <span class="info-value">@Model.TrekPackage.StartEndPoint</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.BestSeason))
                    {
                        <div class="info-item">
                            <span class="info-label">Best Season</span>
                            <span class="info-value">@Model.TrekPackage.BestSeason</span>
                        </div>
                    }
                    @if (Model.AvailableDepartures?.Any() == true)
                    {
                        <div class="info-item">
                            <span class="info-label">Next Departure</span>
                            <span class="info-value">@Model.AvailableDepartures.First().StartDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    }
                </div>

                <!-- Available Departures -->
                @if (Model.AvailableDepartures?.Any() == true)
                {
                    <div class="quick-info" style="margin-top: 1rem;">
                        <h3 style="margin-bottom: 1rem; color: #2c5aa0;">Available Departures</h3>
                        @foreach (var departure in Model.AvailableDepartures.Take(5))
                        {
                            <div class="info-item">
                                <span class="info-label">@departure.StartDate.ToString("MMM dd")</span>
                                <span class="info-value">@departure.AvailableSpots spots left</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        // Toggle itinerary days
        function toggleDay(element) {
            const content = element.nextElementSibling;
            const icon = element.querySelector('i');
            
            if (content.classList.contains('active')) {
                content.classList.remove('active');
                icon.style.transform = 'rotate(0deg)';
            } else {
                // Close all other days
                document.querySelectorAll('.day-content').forEach(day => {
                    day.classList.remove('active');
                });
                document.querySelectorAll('.day-header i').forEach(i => {
                    i.style.transform = 'rotate(0deg)';
                });
                
                // Open current day
                content.classList.add('active');
                icon.style.transform = 'rotate(180deg)';
            }
        }

        // Toggle FAQ items
        function toggleFAQ(element) {
            const answer = element.nextElementSibling;
            const icon = element.querySelector('i');
            
            if (answer.classList.contains('active')) {
                answer.classList.remove('active');
                icon.style.transform = 'rotate(0deg)';
            } else {
                answer.classList.add('active');
                icon.style.transform = 'rotate(180deg)';
            }
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            // Add any initialization code here
            console.log('Trek details page loaded');
        });
    </script>
</body>
</html>
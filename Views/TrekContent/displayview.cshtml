@model UserRoles.ViewModels.TrekPackageDisplayViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.TrekPackage.Title | @Model.TrekPackage.Duration | Trek Packages @DateTime.Now.Year/@(DateTime.Now.Year + 1)</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background: #f8f9fa;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, rgba(0,0,0,0.7), rgba(0,0,0,0.5)), url('@Model.TrekPackage.FeaturedImageUrl');
            background-size: cover;
            background-position: center;
            min-height: 70vh;
            display: flex;
            align-items: center;
            color: white;
            position: relative;
        }

        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .hero-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            margin: 2rem 0;
        }

        .meta-item {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            padding: 1rem;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.2);
        }

        .meta-item h3 {
            font-size: 0.9rem;
            opacity: 0.8;
            margin-bottom: 0.5rem;
        }

        .meta-item p {
            font-size: 1.1rem;
            font-weight: 600;
        }

        .price-badge {
            position: absolute;
            top: 2rem;
            right: 2rem;
            background: linear-gradient(135deg, #ff6b35, #f7931e);
            padding: 1.5rem;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .price-badge .price {
            font-size: 2.5rem;
            font-weight: 700;
            line-height: 1;
        }

        .price-badge .per-person {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        /* Navigation Tabs */
        .nav-tabs {
            background: white;
            border-bottom: 2px solid #eee;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-tabs ul {
            display: flex;
            list-style: none;
            overflow-x: auto;
        }

        .nav-tabs li {
            white-space: nowrap;
        }

        .nav-tabs a {
            display: block;
            padding: 1rem 2rem;
            text-decoration: none;
            color: #666;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
        }

        .nav-tabs a:hover,
        .nav-tabs a.active {
            color: #ff6b35;
            border-bottom-color: #ff6b35;
        }

        /* Content Sections */
        .content-section {
            background: white;
            margin: 2rem 0;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .section-header {
            background: linear-gradient(135deg, #ff6b35, #f7931e);
            color: white;
            padding: 2rem;
        }

        .section-header h2 {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .section-content {
            padding: 2rem;
        }

        /* Overview */
        .overview-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 2rem;
            margin: 2rem 0;
        }

        .key-points {
            background: #f8f9fa;
            padding: 2rem;
            border-radius: 10px;
        }

        .key-points ul {
            list-style: none;
        }

        .key-points li {
            padding: 0.5rem 0;
            border-bottom: 1px solid #eee;
            position: relative;
            padding-left: 2rem;
        }

        .key-points li:before {
            content: '✓';
            position: absolute;
            left: 0;
            color: #28a745;
            font-weight: bold;
        }

        /* Itinerary */
        .itinerary-day {
            background: #f8f9fa;
            margin: 1rem 0;
            border-radius: 10px;
            overflow: hidden;
            border-left: 5px solid #ff6b35;
        }

        .day-header {
            background: white;
            padding: 1.5rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .day-header h3 {
            color: #ff6b35;
            font-size: 1.3rem;
        }

        .day-details {
            padding: 1.5rem;
            border-top: 1px solid #eee;
        }

        .day-meta {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .day-meta-item {
            background: white;
            padding: 1rem;
            border-radius: 8px;
        }

        .day-meta-item strong {
            color: #ff6b35;
            display: block;
            margin-bottom: 0.5rem;
        }

        /* Pricing */
        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin: 2rem 0;
        }

        .pricing-card {
            background: #f8f9fa;
            padding: 2rem;
            border-radius: 15px;
            text-align: center;
            position: relative;
            border: 2px solid transparent;
            transition: all 0.3s;
        }

        .pricing-card:hover {
            border-color: #ff6b35;
            transform: translateY(-5px);
        }

        .pricing-card.featured {
            background: linear-gradient(135deg, #ff6b35, #f7931e);
            color: white;
        }

        .pricing-card h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .pricing-card .price {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 1rem 0;
        }

        /* Highlights */
        .highlights-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .highlight-card {
            background: #f8f9fa;
            padding: 2rem;
            border-radius: 15px;
            text-align: center;
            transition: transform 0.3s;
        }

        .highlight-card:hover {
            transform: translateY(-5px);
        }

        .highlight-icon {
            font-size: 3rem;
            color: #ff6b35;
            margin-bottom: 1rem;
        }

        /* Gallery */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1rem;
        }

        .gallery-item {
            aspect-ratio: 16/9;
            background: #ddd;
            border-radius: 10px;
            overflow: hidden;
            position: relative;
            background-image: url('data:image/placeholder');
            background-size: cover;
            background-position: center;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .gallery-item::after {
            content: attr(data-caption);
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0,0,0,0.8));
            color: white;
            padding: 1rem;
            font-size: 0.9rem;
        }

        /* FAQ */
        .faq-item {
            border: 1px solid #eee;
            margin: 1rem 0;
            border-radius: 10px;
            overflow: hidden;
        }

        .faq-question {
            background: #f8f9fa;
            padding: 1.5rem;
            cursor: pointer;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .faq-answer {
            padding: 1.5rem;
            background: white;
            display: none;
        }

        /* Departures */
        .departures-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .departure-card {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 10px;
            border-left: 5px solid #28a745;
        }

        .departure-card.limited {
            border-left-color: #ffc107;
        }

        .departure-card.full {
            border-left-color: #dc3545;
            opacity: 0.7;
        }

        /* Responsive */
        media (max-width: 768px) {
            .hero-content h1 {
                font-size: 2.5rem;
            }

            .hero-meta {
                flex-direction: column;
                gap: 1rem;
            }

            .price-badge {
                position: relative;
                top: auto;
                right: auto;
                margin: 2rem 0;
            }

            .overview-grid {
                grid-template-columns: 1fr;
            }

            .nav-tabs ul {
                flex-direction: column;
            }
        }

        .btn {
            background: linear-gradient(135deg, #ff6b35, #f7931e);
            color: white;
            padding: 1rem 2rem;
            border: none;
            border-radius: 25px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(255, 107, 53, 0.3);
        }

        .includes-excludes-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
        }

        .includes-list, .excludes-list {
            background: #f8f9fa;
            padding: 2rem;
            border-radius: 10px;
        }

        .includes-list h3 {
            color: #28a745;
            margin-bottom: 1rem;
        }

        .excludes-list h3 {
            color: #dc3545;
            margin-bottom: 1rem;
        }

        .includes-list ul, .excludes-list ul {
            list-style: none;
        }

        .includes-list li:before {
            content: '✓';
            color: #28a745;
            font-weight: bold;
            margin-right: 0.5rem;
        }

        .excludes-list li:before {
            content: '✗';
            color: #dc3545;
            font-weight: bold;
            margin-right: 0.5rem;
        }

        .rating-stars {
            color: #ffc107;
            margin: 0.5rem 0;
        }

        .review-card {
            background: #f8f9fa;
            padding: 1.5rem;
            border-radius: 10px;
            margin: 1rem 0;
            border-left: 4px solid #ff6b35;
        }

        media (max-width: 768px) {
            .includes-excludes-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="hero-content">
                <h1>@Model.TrekPackage.Title</h1>
                <p>@Model.TrekPackage.ShortDescription</p>

                <div class="hero-meta">
                    <div class="meta-item">
                        <h3>Duration</h3>
                        <p>@Model.TrekPackage.Duration</p>
                    </div>
                    <div class="meta-item">
                        <h3>Difficulty</h3>
                        <p>@Model.TrekPackage.Difficulty</p>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.MaxAltitude))
                    {
                        <div class="meta-item">
                            <h3>Max Altitude</h3>
                            <p>@Model.TrekPackage.MaxAltitude</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TrekPackage.TrekkingDistance))
                    {
                        <div class="meta-item">
                            <h3>Distance</h3>
                            <p>@Model.TrekPackage.TrekkingDistance</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="price-badge">
            <div class="price">@Model.TrekPackage.CostInfo.BasePrice @Model.TrekPackage.CostInfo.BasePrice.ToString("N0")</div>
            <div class="per-person">per person</div>
        </div>
    </section>

    <!-- Navigation -->
    <nav class="nav-tabs">
        <div class="container">
            <ul>
                <li><a href="#overview" class="active">Overview</a></li>
                @if (Model.TrekPackage.Itinerary.Days?.Any() == true)
                {
                    <li><a href="#itinerary">Itinerary</a></li>
                }
                <li><a href="#pricing">Pricing</a></li>
                @if (Model.TrekPackage.Highlights?.Any() == true)
                {
                    <li><a href="#highlights">Highlights</a></li>
                }
                @if (Model.IncludesByCategory?.Any() == true || Model.ExcludesByCategory?.Any() == true)
                {
                    <li><a href="#includes">Includes/Excludes</a></li>
                }
                @if (Model.TrekPackage.GalleryImages?.Any() == true)
                {
                    <li><a href="#gallery">Gallery</a></li>
                }
                @if (Model.FAQsByCategory?.Any() == true)
                {
                    <li><a href="#faq">FAQ</a></li>
                }
                @if (Model.AvailableDepartures?.Any() == true)
                {
                    <li><a href="#departures">Departures</a></li>
                }
                @if (Model.LatestReviews?.Any() == true)
                {
                    <li><a href="#reviews">Reviews</a></li>
                }
            </ul>
        </div>
    </nav>

    <div class="container">
        <!-- Overview Section -->
        <section id="overview" class="content-section">
            <div class="section-header">
                <h2>Trek Overview</h2>
                <p>@Model.TrekPackage.ShortDescription</p>
            </div>
            <div class="section-content">
                <div class="overview-grid">
                    <div>
                        @if (!string.IsNullOrEmpty(Model.TrekPackage.Overview.Description))
                        {
                            @Html.Raw(Model.TrekPackage.Overview.Description)
                        }

                        @if (!string.IsNullOrEmpty(Model.TrekPackage.Overview.ImportantNote))
                        {
                            <div style="background: #e3f2fd; padding: 1.5rem; border-radius: 10px; margin: 2rem 0; border-left: 5px solid #2196f3;">
                                <h4 style="color: #1976d2; margin-bottom: 1rem;">Important Note</h4>
                                <p>@Model.TrekPackage.Overview.ImportantNote</p>
                            </div>
                        }
                    </div>

                    @if (Model.TrekPackage.Overview.KeyPoints?.Any() == true)
                    {
                        <div class="key-points">
                            <h3>Key Points</h3>
                            <ul>
                                @foreach (var point in Model.TrekPackage.Overview.KeyPoints)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Itinerary Section -->
        @if (Model.TrekPackage.Itinerary.Days?.Any() == true)
        {
            <section id="itinerary" class="content-section">
                <div class="section-header">
                    <h2>Detailed Itinerary</h2>
                    <p>Day-by-day breakdown of your adventure</p>
                </div>
                <div class="section-content">
                    @foreach (var day in Model.TrekPackage.Itinerary.Days.OrderBy(d => d.DayNumber))
                    {
                        <div class="itinerary-day">
                            <div class="day-header">
                                <h3>Day @day.DayNumber: @day.Title</h3>
                                <span>+</span>
                            </div>
                            <div class="day-details">
                                @if (!string.IsNullOrEmpty(day.Description))
                                {
                                    <p>@day.Description</p>
                                }
                                <div class="day-meta">
                                    @if (!string.IsNullOrEmpty(day.Altitude))
                                    {
                                        <div class="day-meta-item">
                                            <strong>Altitude:</strong> @day.Altitude
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(day.Duration))
                                    {
                                        <div class="day-meta-item">
                                            <strong>Duration:</strong> @day.Duration
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(day.Accommodation))
                                    {
                                        <div class="day-meta-item">
                                            <strong>Accommodation:</strong> @day.Accommodation
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(day.Meals))
                                    {
                                        <div class="day-meta-item">
                                            <strong>Meals:</strong> @day.Meals
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(day.Activities))
                                    {
                                        <div class="day-meta-item">
                                            <strong>Activities:</strong> @day.Activities
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(day.Transportation))
                                    {
                                        <div class="day-meta-item">
                                            <strong>Transportation:</strong> @day.Transportation
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        <!-- Pricing Section -->
        <section id="pricing" class="content-section">
            <div class="section-header">
                <h2>Trek Pricing</h2>
                <p>Competitive prices with flexible options</p>
            </div>
            <div class="section-content">
                @if (Model.TrekPackage.CostInfo.GroupPricing?.Any() == true)
                {
                    <div class="pricing-grid">
                        @foreach (var pricing in Model.TrekPackage.CostInfo.GroupPricing)
                        {
                            <div class="pricing-card @(Model.TrekPackage.CostInfo.GroupPricing.Count() > 1 && pricing == Model.TrekPackage.CostInfo.GroupPricing.ElementAt(1) ? "featured" : "")">
                                <h3>@pricing.GroupSize</h3>
                                <div class="price">@Model.TrekPackage.CostInfo.Currency @pricing.PricePerPerson.ToString("N0")</div>
                                <p>per person</p>
                                @if (Model.TrekPackage.CostInfo.GroupPricing.Count() > 1 && pricing == Model.TrekPackage.CostInfo.GroupPricing.ElementAt(1))
                                {
                                    <span style="background: rgba(255,255,255,0.2); padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.9rem;">Most Popular</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="pricing-grid">
                        <div class="pricing-card featured">
                            <h3>Standard Package</h3>
                            <div class="price">@Model.TrekPackage.CostInfo.Currency @Model.TrekPackage.CostInfo.BasePrice.ToString("N0")</div>
                            <p>per person</p>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.TrekPackage.CostInfo.PriceNote))
                {
                    <div style="background: #f8f9fa; padding: 2rem; border-radius: 10px; margin: 2rem 0;">
                        <p>@Model.TrekPackage.CostInfo.PriceNote</p>
                    </div>
                }
            </div>
        </section>

        <!-- Highlights Section -->
        @if (Model.TrekPackage.Highlights?.Any() == true)
        {
            <section id="highlights" class="content-section">
                <div class="section-header">
                    <h2>Trek Highlights</h2>
                    <p>What makes this trek unforgettable</p>
                </div>
                <div class="section-content">
                    <div class="highlights-grid">
                        @foreach (var highlight in Model.TrekPackage.Highlights.OrderBy(h => h.SortOrder))
                        {
                            <div class="highlight-card">
                                @if (!string.IsNullOrEmpty(highlight.IconClass))
                                {
                                    <div class="highlight-icon">
                                        <i class="@highlight.IconClass"></i>
                                    </div>
                                }
                                <h3>@highlight.Title</h3>
                                <p>@highlight.Description</p>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- Includes/Excludes Section -->
        @if (Model.IncludesByCategory?.Any() == true || Model.ExcludesByCategory?.Any() == true)
        {
            <section id="includes" class="content-section">
                <div class="section-header">
                    <h2>What's Included & Excluded</h2>
                    <p>Complete breakdown of your package</p>
                </div>
                <div class="section-content">
                    <div class="includes-excludes-grid">
                        @if (Model.IncludesByCategory?.Any() == true)
                        {
                            <div class="includes-list">
                                <h3>✓ Included</h3>
                                @foreach (var category in Model.IncludesByCategory)
                                {
                                    @if (category.Value?.Any() == true)
                                    {
                                        @if (!string.IsNullOrEmpty(category.Key) && category.Key != "General")
                                        {
                                            <h4 style="margin: 1rem 0 0.5rem 0; color: #28a745;">@category.Key</h4>
                                        }
                                        <ul>
                                            @foreach (var item in category.Value.OrderBy(i => i.SortOrder))
                                            {
                                                <li>
                                                    @item.Item
                                                    @if (!string.IsNullOrEmpty(item.Description))
                                                    {
                                                        <small style="display: block; color: #666; margin-top: 0.2rem;">@item.Description</small>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                }
                            </div>
                        }

                        @if (Model.ExcludesByCategory?.Any() == true)
                        {
                            <div class="excludes-list">
                                <h3>✗ Not Included</h3>
                                @foreach (var category in Model.ExcludesByCategory)
                                {
                                    @if (category.Value?.Any() == true)
                                    {
                                        @if (!string.IsNullOrEmpty(category.Key) && category.Key != "General")
                                        {
                                            <h4 style="margin: 1rem 0 0.5rem 0; color: #dc3545;">@category.Key</h4>
                                        }
                                        <ul>
                                            @foreach (var item in category.Value.OrderBy(i => i.SortOrder))
                                            {
                                                <li>
                                                    @item.Item
                                                    @if (!string.IsNullOrEmpty(item.Description))
                                                    {
                                                        <small style="display: block; color: #666; margin-top: 0.2rem;">@item.Description</small>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- Gallery Section -->
        @if (Model.TrekPackage.GalleryImages?.Any() == true)
        {
            <section id="gallery" class="content-section">
                <div class="section-header">
                    <h2>Photo Gallery</h2>
                    <p>Glimpses of your upcoming adventure</p>
                </div>
                <div class="section-content">
                    <div class="gallery-grid">
                        @foreach (var image in Model.TrekPackage.GalleryImages.OrderBy(g => g.SortOrder))
                        {
                            <div class="gallery-item" data-caption="@image.Caption">
                                <img src="@image.ImageUrl" alt="@image.AltText" loading="lazy" />
                            </div>
                        }
                    </div>
                </div>
            </section>
        }

        <!-- FAQ Section -->
        @if (Model.FAQsByCategory?.Any() == true)
        {
            <section id="faq" class="content-section">
                <div class="section-header">
                    <h2>Frequently Asked Questions</h2>
                    <p>Everything you need to know about the trek</p>
                </div>
                <div class="section-content">
                    @foreach (var category in Model.FAQsByCategory)
                    {
                        @if (category.Value?.Any() == true)
                        {
                            @if (!string.IsNullOrEmpty(category.Key) && category.Key != "General")
                            {
                                <h3 style="margin: 2rem 0 1rem 0; color: #ff6b35;">@category.Key</h3>
                            }
                            @foreach (var faq in category.Value.OrderBy(f => f.SortOrder))
                            {
                                <div class="faq-item">
                                    <div class="faq-question">
                                        <span>@faq.Question</span>
                                        <span>+</span>
                                    </div>
                                    <div class="faq-answer">
                                        <p>@Html.Raw(faq.Answer)</p>
